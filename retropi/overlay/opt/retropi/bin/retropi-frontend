#!/usr/bin/env bash
# Runs inside X. Picks the best frontend that is actually installed and keeps
# it alive; if it dies we relaunch rather than dumping the user at a console.
set -uo pipefail
# Resolve our own install prefix, so these run identically from /opt/retropi
# and from a source checkout (overlay$RETROPI_BIN/...).
: "${RETROPI_PREFIX:=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
. "$RETROPI_PREFIX/lib/common.sh"

xset -dpms s off s noblank 2>/dev/null || true
unclutter -idle 0.5 -root >/dev/null 2>&1 &

ESDE_APPIMAGE=$RETROPI_PREFIX/share/ES-DE.AppImage

launch() {
    if [ -x "$ESDE_APPIMAGE" ]; then
        "$ESDE_APPIMAGE" --no-splash
    elif have emulationstation; then
        emulationstation
    elif have pegasus-fe; then
        pegasus-fe
    else
        # Last resort, and not a bad one: RetroArch's own Ozone menu is fully
        # controller-driven and can browse the ROM directories directly.
        retroarch --fullscreen
    fi
}

while true; do
    launch
    rc=$?
    # ES-DE returns 0 on a requested quit; anything else is a crash we ride out.
    if [ $rc -eq 0 ] && [ -e "$RETROPI_STATE/quit-requested" ]; then
        rm -f "$RETROPI_STATE/quit-requested"
        break
    fi
    warn "frontend exited (rc=$rc), restarting"
    sleep 2
done
