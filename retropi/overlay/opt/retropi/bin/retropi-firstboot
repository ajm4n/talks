#!/usr/bin/env bash
# Console wizard, shown once, on the TV, before the frontend starts.
# Everything it asks can also be pre-answered by editing retropi.conf on the
# boot (FAT) partition from any machine, in which case those steps are skipped.
set -uo pipefail
: "${RETROPI_PREFIX:=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
. "$RETROPI_PREFIX/lib/common.sh"

export NEWT_COLORS='root=,black
window=black,black
border=cyan,black
title=white,black
textbox=white,black
button=black,cyan
compactbutton=white,black
listbox=white,black
actlistbox=black,cyan
actsellistbox=black,cyan
checkbox=white,black
entry=white,black
label=white,black
emptyscale=black,black
fullscale=cyan,black
helpline=cyan,black
roottext=cyan,black'

ui()  { whiptail --backtitle "  R E T R O P i" "$@" 3>&1 1>&2 2>&3; }
msg() { whiptail --backtitle "  R E T R O P i" --msgbox "$1" 14 72; }
ask() { whiptail --backtitle "  R E T R O P i" --yesno "$1" 14 72; }

step_welcome() {
    msg "
   R E T R O P i


   Welcome. A few quick questions and you are playing.

   You can use a keyboard to answer these. After this,
   everything is controller-driven.

   Re-run any time with:  retropi-setup"
}

step_wifi() {
    have nmcli || return 0
    nmcli -t -f STATE general | grep -q connected && return 0
    ask "Set up Wi-Fi now?\n\n(Skip this if the Pi is on ethernet.)" || return 0

    local ssid pass ssids
    ssids=$(nmcli -t -f SSID,SIGNAL dev wifi list --rescan yes \
            | awk -F: 'length($1) { printf "%s %s%%\n", $1, $2 }' | sort -u | head -n 20)
    [ -n "$ssids" ] || { msg "No networks found. You can set Wi-Fi up later."; return 0; }

    # shellcheck disable=SC2086
    ssid=$(ui --title "Wi-Fi" --menu "Pick your network" 20 68 10 $ssids) || return 0
    pass=$(ui --title "Wi-Fi" --passwordbox "Password for $ssid" 10 68) || return 0

    if nmcli dev wifi connect "$ssid" password "$pass" >/dev/null 2>&1; then
        msg "Connected to $ssid."
    else
        msg "Could not connect to $ssid. Carrying on - you can retry later."
    fi
}

step_controller() {
    if $RETROPI_BIN/retropi-bt-pair status >/dev/null 2>&1; then
        msg "Controller already connected."
        return 0
    fi
    ask "Pair a Bluetooth controller now?\n\nPut the pad into pairing mode:\n\n  PS4/PS5       hold Share + PS button\n  Xbox          hold the pair button (top edge)\n  Switch Pro    hold Sync button (top)\n  8BitDo        hold Start, then Select 3s\n\nMost controllers: hold the button that\nmakes the lights flash." || return 0

    {
        echo 10; sleep 1
        $RETROPI_BIN/retropi-bt-pair pair 60 &
        local pid=$!
        for i in $(seq 15 5 95); do echo "$i"; sleep 3; done
        wait $pid
    } | whiptail --gauge "Scanning for controllers..." 8 68 0

    if $RETROPI_BIN/retropi-bt-pair status >/dev/null 2>&1; then
        msg "Paired! It will reconnect automatically from now on.\n\nYou can pair more controllers any time from the\nRetroPi menu."
    else
        msg "No controller found yet.\n\nThe pairing daemon keeps scanning in the background.\nJust put the pad in pairing mode and it will connect."
    fi
}

step_library() {
    local choice
    choice=$(ui --title "Where are your games?" --menu \
        "You can change this later with: retropi-library" 18 72 4 \
        local   "On this Pi (SD card or attached USB/SSD)" \
        network "On a NAS or PC share - played over the network" \
        usb     "Copy from a USB stick when I plug one in" \
        skip    "Decide later") || return 0

    case $choice in
        local)
            mkdir -p "$RETROPI_ROMS"
            chown -R "$RETROPI_USER":"$RETROPI_USER" "$RETROPI_ROMS"
            msg "Put game files in:\n\n  $RETROPI_ROMS/<system>/\n\ne.g. $RETROPI_ROMS/snes/\n\nOr use the web portal:\n  http://$(hostname).local:8080\n\nOr the network share:\n  \\\\$(hostname)\\ROMs"
            conf_set library_type none
            ;;
        network)
            local kind host share user pass
            kind=$(ui --title "Share type" --menu "" 12 60 2 \
                smb "Windows / Samba / most NAS boxes" \
                nfs "NFS export") || return 0
            host=$(ui --inputbox "Server address (hostname or IP)" 10 60 "") || return 0
            share=$(ui --inputbox "Share name or export path" 10 60 "ROMs") || return 0
            conf_set library_type "$kind"
            conf_set library_host "$host"
            conf_set library_share "$share"
            if [ "$kind" = "smb" ]; then
                user=$(ui --inputbox "Username (leave blank for guest)" 10 60 "guest") || true
                pass=$(ui --passwordbox "Password (blank for guest)" 10 60) || true
                conf_set library_user "${user:-guest}"
                conf_set library_pass "${pass:-}"
                chmod 600 "$RETROPI_CONF"
            fi
            if $RETROPI_BIN/retropi-library mount; then
                msg "Share attached. Games load straight off the network."
            else
                msg "Could not attach the share. Check the details and re-run:\n  sudo retropi-library mount"
            fi
            ;;
        usb)
            conf_set usb_import yes
            msg "Put a ROMs folder on a USB stick with subfolders per system.\nPlug it in and the Pi copies everything across."
            ;;
    esac
}

step_streaming() {
    have moonlight || return 0
    ask "Stream games from a gaming PC?\n\nIf you run Sunshine on a PC on this network, the Pi can\nplay its entire library at full speed over the network.\n\nSet that up now?" || return 0

    local host pin
    host=$(ui --inputbox "PC hostname or IP" 10 60 "") || return 0
    [ -n "$host" ] || return 0
    conf_set stream_host "$host"
    pin=$(moonlight pair "$host" 2>&1 | grep -oE '[0-9]{4}' | head -n1)
    if [ -n "$pin" ]; then
        msg "Enter this PIN on the PC:\n\n        $pin\n\nThen press OK."
    else
        msg "Pairing did not start. Check that Sunshine is running on $host."
    fi
}

step_done() {
    mark_done firstboot
    msg "
   All set.


   Controller shortcuts (hold Select):

     Select + Start     quit to menu
     Select + X         RetroArch settings
     Select + R1 / L1   save / load state
     Select + R2 / L2   fast-forward / rewind


   Re-run this wizard:  retropi-setup"
}

main() {
    have whiptail || { warn "whiptail missing, skipping wizard"; mark_done firstboot; return 0; }
    step_welcome
    step_wifi
    step_controller
    step_library
    step_streaming
    step_done
}

main "$@"
