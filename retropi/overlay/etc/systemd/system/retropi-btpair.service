[Unit]
Description=RetroPi Bluetooth gamepad pairing daemon
After=bluetooth.service
Wants=bluetooth.service
PartOf=bluetooth.service

[Service]
Type=simple
ExecStart=/opt/retropi/bin/retropi-bt-pair daemon
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
